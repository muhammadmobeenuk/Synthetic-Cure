# Production requires PostgreSQL and a generated session secret (32+ characters).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jadesun
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3000
# Development only. Never enable with real customer data.
DEMO_MODE=false

# Stable installation company code; existing JadeSun installations retain jadesun.
COMPANY_ID=jadesun
COMPANY_NAME=
# Server, backup and restore must use the same private volume. Restore needs a fresh path.
UPLOAD_DIR=runtime/private
# Native verification ONLY: two empty disposable databases, never operational data.
TEST_DATABASE_URL=
TEST_RESTORE_DATABASE_URL=

# Optional server-side document recognition. Never use VITE_ or commit keys.
# Local processing requires installed Tesseract and language data.
OCR_LOCAL_LANGUAGES=eng
# Gemini sends the selected document to Google only after staff confirmation.
GEMINI_API_KEY=
GEMINI_MODEL=
